<odoo>
    <data>
        <!-- ===== LIST VIEW ===== -->
        <!-- Custom list view chấm công cho người dùng -->
        <record id="beeone_view_attendance_list" model="ir.ui.view">
            <field name="name">attendance.list</field>
            <field name="model">hr.attendance</field>
            <field name="priority">1</field> <!-- Ưu tiên list view này-->
            <field name="arch" type="xml">
                <list string="Chấm công" 
                      js_class="attendance_list_view" 
                      decoration-success="color == 10" 
                      decoration-danger="color == 1"
                      duplicate="false">
                    <field name="employee_id" widget="many2one_avatar_user" width="180px"/>
                    <field name="check_in"/>
                    <field name="check_out"/>
                    <field name="worked_hours" string="Giờ đã làm việc" widget="float_time"/>
                    <field name="overtime_hours" string="Giờ làm thêm đã làm" optional="show" widget="float_time"/>
                    <field name="validated_overtime_hours" string="Giờ làm thêm" optional="show" widget="float_time"/>
                    <field name="overtime_status" optional="hidden" widget="badge" 
                           decoration-warning="overtime_status == 'to_approve'" 
                           decoration-success="overtime_status == 'approved'" 
                           decoration-danger="overtime_status == 'refused'"/>
                    <field name="color" column_invisible="1"/>
                </list>
            </field>
        </record>

        <!-- ===== PIVOT VIEW (BÁO CÁO) ===== -->
        <!-- Custom pivot view báo cáo giờ làm việc -->
        <record id="beeone_view_attendance_pivot" model="ir.ui.view">
            <field name="name">attendance.pivot.beeone</field>
            <field name="model">hr.attendance</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <pivot string="Báo cáo giờ làm việc">
                    <field name="employee_id" type="row"/>
                    <field name="check_in" type="col" interval="month"/>
                    <field name="worked_hours" string="Giờ đã làm" type="measure" widget="float_time"/>
                    <field name="expected_hours" string="Giờ mong đợi" type="measure" widget="float_time"/>
                    <field name="overtime_hours" string="Chênh lệch" type="measure" widget="float_time"/>
                    <field name="validated_overtime_hours" string="Số dư" type="measure" widget="float_time"/>
                </pivot>
            </field>
        </record>

        <!-- ===== GRAPH VIEW (BIỂU ĐỒ - Optional) ===== -->
        <!-- Custom graph view để xem trực quan -->
        <record id="beeone_view_attendance_graph" model="ir.ui.view">
            <field name="name">attendance.graph.beeone</field>
            <field name="model">hr.attendance</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <graph string="Biểu đồ giờ làm việc" type="bar">
                    <field name="employee_id"/>
                    <field name="worked_hours" type="measure" widget="float_time"/>
                </graph>
            </field>
        </record>


        <!-- ===== ACTIONS ===== -->
        <!-- Action của view nhân viên (List) -->
        <record id="beeone_action_attendance_user" model="ir.actions.act_window">
            <field name="name">Chấm công</field>
            <field name="res_model">hr.attendance</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="beeone_view_attendance_list"/>
            <field name="domain">[('employee_id.user_id', '=', uid)]</field>
            <field name="context">{}</field>
        </record>

        <!-- Action của manager (List) -->
        <record id="beeone_action_attendance_manager" model="ir.actions.act_window">
            <field name="name">Chấm công</field>
            <field name="res_model">hr.attendance</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="beeone_view_attendance_list"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <!-- Action BÁO CÁO của nhân viên (Pivot + Graph - KHÔNG có List) -->
        <record id="beeone_action_attendance_report_user" model="ir.actions.act_window">
            <field name="name">Báo cáo giờ làm việc</field>
            <field name="res_model">hr.attendance</field>
            <field name="view_mode">pivot,graph</field>
            <field name="view_id" ref="beeone_view_attendance_pivot"/>
            <field name="domain">[('employee_id.user_id', '=', uid)]</field>
            <field name="context">{'group_by': ['employee_id', 'check_in']}</field>
        </record>

        <!-- Action BÁO CÁO của manager (Pivot + Graph + List) -->
        <record id="beeone_action_attendance_report_manager" model="ir.actions.act_window">
            <field name="name">Báo cáo giờ làm việc</field>
            <field name="res_model">hr.attendance</field>
            <field name="view_mode">pivot,graph,list</field>
            <field name="view_id" ref="beeone_view_attendance_pivot"/>
            <field name="domain">[]</field>
            <field name="context">{'group_by': ['employee_id', 'check_in']}</field>
        </record>


        <!-- ===== MENU ITEMS ===== -->
        <!-- Menu Chấm công cho nhân viên -->
        <menuitem id="beeone_menu_attendance_user"
                    name="Chấm công"
                    parent="home_menu.home_root"
                    action="beeone_action_attendance_user"
                    groups="beeone.group_beeone_employee,beeone.group_beeone_marketing"
                    sequence="10"/>

        <!-- Menu Chấm công cho quản lý -->
        <menuitem id="beeone_menu_attendance_manager"
                    name="Chấm công"
                    parent="home_menu.home_root"
                    action="beeone_action_attendance_manager"
                    groups="beeone.group_beeone_manager"
                    sequence="10"/>

        <!-- Menu BÁO CÁO cho nhân viên -->
        <menuitem id="beeone_menu_attendance_report_user"
                    name="Báo cáo"
                    parent="home_menu.home_root"
                    action="beeone_action_attendance_report_user"
                    groups="beeone.group_beeone_employee,beeone.group_beeone_marketing"
                    sequence="11"/>

        <!-- Menu BÁO CÁO cho quản lý -->
        <menuitem id="beeone_menu_attendance_report_manager"
                    name="Báo cáo"
                    parent="home_menu.home_root"
                    action="beeone_action_attendance_report_manager"
                    groups="beeone.group_beeone_manager"
                    sequence="11"/>

    </data>
</odoo>